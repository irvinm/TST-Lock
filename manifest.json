{
  "browser_action": {
    "default_icon": "images/lock.png",
    "default_title": "TST Lock",
    "default_popup": "options/popup.html"
  },
  "description": "Lock important tabs from being accidentally closed.",
  "homepage_url": "https://github.com/irvinm/TST-Lock",
  "manifest_version": 2,
  "name": "TST Lock",
  "version": "1.1.7",
  "permissions": [
    "sessions",
    "tabs",
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "128": "images/lock.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "TST-Lock@irvinm.addons.mozilla.org",
      "strict_min_version": "115.0",
      "//": "Firefox 115 ESR supported until March 2027",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    "images/*.png"
  ]
}